# ── Required in production ───────────────────────────────────────────────────
# Shared password you and your partner type once per device.
APP_PASSWORD=choose-a-password

# Signs the login cookie. Any long random string; changing it logs everyone out.
# Generate one with:  openssl rand -hex 32
AUTH_SECRET=replace-with-a-long-random-string

# Postgres connection string. On Vercel this is filled in automatically when you
# connect a database from the Storage tab — you do NOT need to paste it there.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# ── Local development ────────────────────────────────────────────────────────
# With DATABASE_URL unset, the app stores everything in ./.data/orders.json
# instead. Handy for trying it out; not shared with anyone.
