# Anthropic — for recipient name + tracking extraction from PDFs
ANTHROPIC_API_KEY=sk-ant-...

# Wix — Business Manager → Settings → API Keys
WIX_API_KEY=
WIX_SITE_ID=
WIX_ACCOUNT_ID=

# How many days back to show in the dashboard
DAYS=20

# Source for shipping labels:
#   downloads (default) — scan ~/Downloads for israelPost*.pdf files
#   gmail              — fetch via Gmail API (needs credentials.json + OAuth)
SOURCE=downloads

# Optional: override the Downloads folder location
# DOWNLOADS_DIR=/Users/yourname/Downloads

# Optional (gmail mode only): override the Gmail search query
# GMAIL_QUERY=from:noreply@israelpost.co.il subject:תעודות משלוח

# Gmail OAuth (only needed if SOURCE=gmail):
# credentials.json from Google Cloud Console → OAuth 2.0 Client → Desktop app.
# token.json is written after the first auth flow.
